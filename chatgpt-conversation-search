#!/usr/bin/env bash
set -euo pipefail

invocation_dir="$PWD"
repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "${repo_root}"

usage() {
  cat <<'EOF'
Usage:
  chatgpt-conversation-search doctor
  chatgpt-conversation-search ingest /absolute/path/to/conversations.json
  chatgpt-conversation-search status
  chatgpt-conversation-search server
  chatgpt-conversation-search search [--author assistant] [--limit 3] "query text"
  chatgpt-conversation-search mcp

Notes:
  - default path uses local Ollama + local Qdrant
  - for ingest, path can also come from CHATGPT_EXPORT_PATH
  - set CHATGPT_FORMAT=yaml for YAML search output
EOF
}

cmd="${1:-help}"
shift || true

case "${cmd}" in
  help|-h|--help)
    usage
    ;;
  doctor)
    exec make chatgpt-doctor
    ;;
  status)
    exec make chatgpt-status
    ;;
  server)
    exec make chatgpt-server
    ;;
  mcp)
    exec make chatgpt-mcp
    ;;
  ingest)
    export_path="${1:-${CHATGPT_EXPORT_PATH:-}}"
    if [[ -z "${export_path}" ]]; then
      echo "missing export path; pass file path or set CHATGPT_EXPORT_PATH" >&2
      exit 1
    fi
    exec make chatgpt-ingest "EXPORT=${export_path}" "REPORT_OUT=${invocation_dir}/ingest_report.json"
    ;;
  search)
    query_parts=()
    search_args=()
    format="${CHATGPT_FORMAT:-json}"
    server_url="${CHATGPT_SERVER_URL:-http://127.0.0.1:18080}"
    expect_value=""
    for arg in "$@"; do
      if [[ -n "${expect_value}" ]]; then
        if [[ "${expect_value}" == "query" ]]; then
          query_parts+=("${arg}")
        elif [[ "${expect_value}" == "format" ]]; then
          format="${arg}"
        elif [[ "${expect_value}" == "server" ]]; then
          server_url="${arg}"
        else
          search_args+=("${arg}")
        fi
        expect_value=""
        continue
      fi
      case "${arg}" in
        --query)
          expect_value="query"
          ;;
        --author|--thread_id|--from|--to|--limit)
          search_args+=("${arg}")
          expect_value="flag"
          ;;
        --format)
          expect_value="format"
          ;;
        --server)
          expect_value="server"
          ;;
        --help|-h)
          usage
          exit 0
          ;;
        --*)
          echo "unsupported search flag: ${arg}" >&2
          exit 1
          ;;
        *)
          query_parts+=("${arg}")
          ;;
      esac
    done
    if [[ -n "${expect_value}" ]]; then
      echo "missing value for final search flag" >&2
      exit 1
    fi
    query="${query_parts[*]:-}"
    if [[ -z "${query}" ]]; then
      echo "missing query text" >&2
      exit 1
    fi
    extra_args=""
    if [[ ${#search_args[@]} -gt 0 ]]; then
      printf -v extra_args '%q ' "${search_args[@]}"
      extra_args="${extra_args% }"
    fi
    exec make chatgpt-search \
      "QUERY=${query}" \
      "CHATGPT_FORMAT=${format}" \
      "CHATGPT_SERVER_URL=${server_url}" \
      "CHATGPT_SEARCH_ARGS=${extra_args}"
    ;;
  *)
    echo "unknown subcommand: ${cmd}" >&2
    usage >&2
    exit 1
    ;;
esac
